# Copy to .env and edit before running.

# ── First run ────────────────────────────────────────────────────────────────
# Used only when the users table is empty. Without GANXTERM_ADMIN_PASS the
# password is change_me. Either way IguanaXterm asks for a new password on
# every load until it is changed in the app.
GANXTERM_ADMIN_USER=admin
GANXTERM_ADMIN_PASS=change-me-before-exposing

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite database, secret.key and session.key live here. Leave it unset: the
# container uses /data (its volume) and a run from source uses this folder.
# Setting it here would also override the container's /data and put the
# database outside the volume, where recreating the container loses it.
# GANXTERM_DATA_DIR=./data

# Fernet key for credential encryption. Generated into secret.key on first run
# if unset. Back up whichever you use: losing it loses every stored credential.
# GANXTERM_SECRET_KEY=

# ── Service ──────────────────────────────────────────────────────────────────
# Port on this computer (compose publishes it on 127.0.0.1 only).
GANXTERM_PORT=8765

# Folders a browser cannot save itself go to the data volume ("Saved files").
# With compose.downloads.yaml / compose.downloads.podman.yaml they go to this
# folder on the computer instead. A dedicated folder, not ~/Downloads itself.
# GANXTERM_DOWNLOAD_HOST_DIR=~/Downloads/IguanaXterm

# Largest single upload. Default 64 GiB.
# GANXTERM_MAX_UPLOAD_BYTES=68719476736

# Login throttling is pytincture's own; these are its defaults.
# AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=20
# AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Behind a TLS-terminating reverse proxy: the public origin and host name.
# GANXTERM_CANONICAL_ORIGIN=https://terminal.example.com
# GANXTERM_ALLOWED_HOSTS=terminal.example.com
