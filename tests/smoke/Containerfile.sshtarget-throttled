# Throwaway SSH target for IguanaXterm's smoke test. Password auth and a weak
# credential are deliberate: it listens on loopback only and is torn down after.
FROM docker.io/library/alpine:3.20

RUN apk add --no-cache openssh-server openssh-sftp-server shadow \
    && ssh-keygen -A \
    && adduser -D -s /bin/sh testuser \
    && echo 'testuser:testpass' | chpasswd \
    && mkdir -p /home/testuser/docs /home/testuser/logs \
    && echo 'hello from the container' > /home/testuser/readme.txt \
    && echo 'line one' > /home/testuser/logs/app.log \
    && head -c 2048 /dev/urandom > /home/testuser/docs/blob.bin \
    && chown -R testuser:testuser /home/testuser \
    && sed -i 's/^#*PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config \
    && sed -i 's/^#*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config \
    && sed -i 's|^#*Subsystem.*sftp.*|Subsystem sftp /usr/lib/ssh/sftp-server|' /etc/ssh/sshd_config

EXPOSE 22
CMD ["/usr/sbin/sshd", "-D", "-e"]

# Reproduce a host that resets connections under load, which is what produced
# "Error reading SSH protocol banner" in the field. MaxStartups 1:100:2 means:
# beyond 1 unauthenticated connection, drop 100% of new ones up to a hard cap
# of 2.
RUN sed -i '/^MaxStartups/d' /etc/ssh/sshd_config \
    && echo 'MaxStartups 1:100:2' >> /etc/ssh/sshd_config
